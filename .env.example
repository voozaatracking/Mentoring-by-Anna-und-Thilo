# Mailversand des Anfrageformulars über SMTP (zum Beispiel Strato).
# Lokal nach .env.local kopieren, bei Vercel in den Projekteinstellungen setzen.
# Fehlen Werte, schreibt die Entwicklung die Mail in die Konsole.
# In Production antwortet die Route dann mit 503.

SMTP_HOST=
# 465 nutzt TLS direkt, andere Ports STARTTLS.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Absenderadresse. Muss SMTP_USER entsprechen.
MAIL_FROM=
# Empfänger der Anfragen.
MAIL_TO=
# Optional: Kopie an eine weitere Adresse.
MAIL_CC=

# Optional: öffentliche Adresse der Seite für Metadaten, zum Beispiel https://example.de
SITE_URL=
